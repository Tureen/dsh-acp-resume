{
  "name": "dsh-acp-resume",
  "version": "0.1.16",
  "description": "Resumable/continuable ACP subagent provider for DeepSeek Harness: keeps the remote session id, reconnects via session/load, and joins the built-in continuable control surface. Independent sibling of @deepseek-ai/dsh-subagent-acp (registered as provider 'acp-resume').",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "acp",
    "subagent",
    "kiro"
  ],
  "author": "Tureen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tureen/dsh-acp-resume.git"
  },
  "bugs": "https://github.com/Tureen/dsh-acp-resume/issues",
  "homepage": "https://github.com/Tureen/dsh-acp-resume#readme",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "prepack": "rm -rf lib && tsc -p tsconfig.json && tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-brand": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "~0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "~0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-agent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs-local": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "~0.2.1-rc.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
