{
  "name": "dsh-acp-resume",
  "version": "0.1.2",
  "description": "Resumable/continuable ACP subagent provider for DeepSeek Harness: keeps the remote session id, reconnects via session/load, and joins the built-in continuable control surface. Independent sibling of @deepseek-ai/dsh-subagent-acp (registered as provider 'acp-resume').",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "rm -rf lib && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-brand": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "~0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "~0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "~0.2.1-rc.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^24",
    "@deepseek-ai/dsh-agent-loop-testkit": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "~0.2.1-rc.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/dsh-tools": "~0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "~0.2.1-rc.5"
  },
  "engines": {
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
